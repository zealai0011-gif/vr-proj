# Copy to .env locally (never commit .env)

# Neon — use pooler host; sslmode=require only (drop channel_binding if connect fails)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Railway sets PORT automatically
PORT=8080

# Unity Auth Api Key (header X-API-Key)
API_KEY=change-me-to-a-long-random-secret

# Copy to .env locally (never commit .env)

# Aiven PostgreSQL — Service URI from Aiven console (PostgreSQL connection)
# Example port is often 18242; use your service's host/port/database name.
DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD@YOUR_SERVICE.aivencloud.com:18242/defaultdb?sslmode=require

# Railway sets PORT automatically
PORT=8080

# Unity Auth Api Key (header X-API-Key)
API_KEY=change-me-to-a-long-random-secret
